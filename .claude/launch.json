{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kitted-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "web"
      ],
      "port": 8081
    },
    {
      "name": "mockups",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/mockshots/serve.js"
      ],
      "port": 8095
    },
    {
      "name": "kitted-web-8083",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd app && npx expo start --web --port 8083"
      ],
      "port": 8083
    },
    {
      "name": "kitted-metro",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd app && npx expo start --dev-client --port 8081"
      ],
      "port": 8081
    }
  ]
}
