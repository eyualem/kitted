---
// Score numerals in Archivo Condensed SemiBold outlines (glyphs.ts), like the app's ScoreBlock. `size` is the font
// size in px. Hidden from screen readers: the text around them carries the number.
import { DIGITS } from '@/lib/glyphs';
interface Props { text: string; size: number; class?: string }
const { text, size, class: cls } = Astro.props;
const s = size / 100;
let x = 0;
const parts = [...text].map((c) => {
  const g = DIGITS[c];
  if (!g) throw new Error(`No outline for "${c}"`);
  const at = x;
  x += g.width;
  return { d: g.d, at };
});
// The numerals' ink runs from 17.9 to 89 in the 100-unit box (round tops and bottoms overshoot the baseline).
const top = 17.5;
const base = 89.5;
---
<svg
  class={cls}
  width={(x * s).toFixed(1)}
  height={((base - top) * s).toFixed(1)}
  viewBox={`0 ${top} ${x} ${base - top}`}
  fill="currentColor"
  aria-hidden="true"
>
  {parts.map((p) => <path d={p.d} transform={`translate(${p.at} 0)`} />)}
</svg>
