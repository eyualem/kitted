---
import Base from '@/layouts/Base.astro';
---
<Base title="Not here · Kitted" description="This page isn't here.">
  <section class="mx-auto max-w-[680px] px-4 pt-12 sm:px-6">
    <h1 class="text-[32px] font-bold tracking-[-0.02em] text-ink">This page isn't here.</h1>
    <p class="mt-3 text-[17px] text-ink2">It was moved, or the link is old.</p>
    <a href="/" class="mt-6 inline-flex h-[52px] items-center rounded-[14px] bg-primary px-6 text-[17px] font-semibold text-primary-foreground">Go to Kitted</a>
  </section>
</Base>
