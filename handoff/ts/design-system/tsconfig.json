{
  "//": "Standalone strict type-check for the design system BEFORE the Expo app exists. Uses _stubs/. Delete this file and _stubs/ once the folder lives in the app (the app's tsconfig extends expo/tsconfig.base).",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": false,
    "noEmit": true,
    "types": []
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
